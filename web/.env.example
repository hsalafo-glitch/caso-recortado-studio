# Copia este archivo como web/.env y rellénalo. NUNCA lo subas a internet ni lo compartas.

# Dirección pública de tu web, con https (el instalador la pone sola)
CR_URL=https://tudominio.com

# Clave larga y aleatoria para las sesiones (el instalador la genera sola). A mano:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Clave de la API de Claude (console.anthropic.com → API Keys). Sin ella, la web no escribe guiones.
ANTHROPIC_API_KEY=

# Stripe (dashboard.stripe.com). Empieza con las claves de PRUEBA (sk_test_...) y cambia a las reales al final.
STRIPE_SECRET_KEY=
# Developers → Webhooks → tu endpoint https://tudominio.com/stripe/webhook → «Signing secret» (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Product catalog → crea los productos «Creador» y «Pro» con precio mensual y copia sus ID (price_...)
STRIPE_PRECIO_CREADOR=
STRIPE_PRECIO_PRO=

# Opcional: beta privada. Si pones una clave, solo entra quien abra la web con ?clave=ESA_CLAVE
CR_CLAVE=

# Opcional: modo demo (1 = sin IA, usa los guiones de ejemplo)
CR_DEMO=

# ── Lista de espera (antes de abrir) ──
# CR_SOLO_LISTA=1  → la web solo enseña la página de lista de espera (/lista-espera)
CR_SOLO_LISTA=
# Tu email de cuenta en la web: solo tú podrás descargar la lista en /admin/lista.csv
CR_ADMIN_EMAIL=

# ── Emails (recuperar contraseña) ──
# Cualquier SMTP: por ejemplo Brevo (gratis hasta 300 emails/día): smtp-relay.brevo.com, puerto 587.
# Sin esto, los emails se guardan en web/logs/emails.log en vez de enviarse.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DE=no-responder@tudominio.com
